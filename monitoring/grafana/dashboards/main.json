{
  "title": "Event Platform — Delivery",
  "uid": "event-platform-delivery",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Requests",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (rate(http_requests_total[5m]))",
          "legendFormat": "{{service}} requests/s",
          "datasource": {
            "type": "prometheus",
            "uid": "delivery-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (decision, reason) (rate(extractor_limit_decisions_total[5m]))",
          "legendFormat": "{{decision}} / {{reason}}",
          "datasource": {
            "type": "prometheus",
            "uid": "delivery-prometheus"
          }
        }
      ]
    },
    {
      "id": 2,
      "title": "Latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "{{service}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "delivery-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, tier) (rate(extractor_llm_duration_seconds_bucket[5m])))",
          "legendFormat": "Ollama {{tier}} p95",
          "datasource": {
            "type": "prometheus",
            "uid": "delivery-prometheus"
          }
        }
      ]
    },
    {
      "id": 3,
      "title": "Tokens",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tier, direction) (increase(extractor_llm_tokens_total[5m]))",
          "legendFormat": "{{tier}} {{direction}} / 5m",
          "datasource": {
            "type": "prometheus",
            "uid": "delivery-prometheus"
          }
        }
      ]
    },
    {
      "id": 4,
      "title": "Errors",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "delivery-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service, status) (rate(http_requests_total{status=~\"4..|5..\"}[5m]))",
          "legendFormat": "{{service}} {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "delivery-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum by (tier) (rate(extractor_llm_failures_total[5m]))",
          "legendFormat": "{{tier}} fallback",
          "datasource": {
            "type": "prometheus",
            "uid": "delivery-prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "sum by (tier) (rate(extractor_llm_unaccounted_total[5m]))",
          "legendFormat": "{{tier}} unknown tokens",
          "datasource": {
            "type": "prometheus",
            "uid": "delivery-prometheus"
          }
        }
      ]
    }
  ]
}
