# === Общее ===
APP_ENV=dev
LOG_LEVEL=debug

# === База данных ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=event_platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=event_platform

# === Extractor (LLM) ===
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=qwen2.5:1.5b
LLM_ECONOMY_MODEL=qwen2.5:0.5b
OLLAMA_URL=http://ollama:11434
# Server-only authentication. Use unique strong tokens for different owners.
EXTRACTOR_API_TOKENS='{}'
EXTRACTOR_DEMO_TOKEN=
DAILY_REQUEST_LIMIT=100
DAILY_TOKEN_LIMIT=200000
ECONOMY_REQUEST_LIMIT=20
ECONOMY_TOKEN_LIMIT=20000
GRAFANA_ADMIN_PASSWORD=
AI_CALL_TIMEOUT=120
AI_DEADLINE=245
AI_OPERATION_TIMEOUT=600
AI_TRACE_CONTENT=false
AI_TRACE_PATH=logs/llm-traces.jsonl
AI_DB_PATH=data/ai.sqlite
AI_API_TOKENS={"replace-with-random-local-token":"expert-1"}

# === VK Publisher ===
VK_API_VERSION=5.199
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# === Mailer (SMTP) ===
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# === Backend URLs (для compose и внутренних вызовов) ===
EXTRACTOR_URL=http://extractor:8000
COMPOSER_URL=http://page-composer:8000
PUBLISHER_URL=http://vk-publisher:8000
MAILER_URL=http://mailer:8000

# Frontend uses same-origin /api/extractor and /api/composer via Next.js rewrites.
