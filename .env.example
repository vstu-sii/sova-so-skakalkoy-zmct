# === Общее ===
APP_ENV=dev
LOG_LEVEL=debug

# === База данных ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=event_platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=event_platform

# === Extractor (LLM) ===
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# === VK Publisher ===
VK_API_VERSION=5.199
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# === Mailer (SMTP) ===
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# === Backend URLs (для compose и внутренних вызовов) ===
EXTRACTOR_URL=http://extractor:8000
COMPOSER_URL=http://page-composer:8000
PUBLISHER_URL=http://vk-publisher:8000
MAILER_URL=http://mailer:8000

# === Frontend (NEXT_PUBLIC_* обязательны для браузера) ===
NEXT_PUBLIC_EXTRACTOR_URL=http://localhost:8001
NEXT_PUBLIC_COMPOSER_URL=http://localhost:8002