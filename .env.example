# === бщее ===
APP_ENV=dev
LOG_LEVEL=debug

# === аза данных ===
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=event_platform
POSTGRES_PASSWORD=changeme
POSTGRES_DB=event_platform

# === Extractor (LLM) ===
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://127.0.0.1:11434
AI_CALL_TIMEOUT=120
AI_DEADLINE=245
AI_OPERATION_TIMEOUT=600
AI_TRACE_CONTENT=false
AI_TRACE_PATH=logs/llm-traces.jsonl
AI_DB_PATH=data/ai.sqlite
# Replace with a random local token; no default token is accepted.
AI_API_TOKENS={"replace-with-random-local-token":"expert-1"}

# === VK Publisher ===
VK_API_VERSION=5.199
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# === Mailer (SMTP) ===
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=

# === Frontend ===
VITE_API_URL=http://localhost:8000
